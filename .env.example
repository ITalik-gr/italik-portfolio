# Copy to .env.local (git-ignored) and fill in. On Vercel set the same names in Project Settings → Environment Variables.

# Anthropic API key for the Ask AI chat. Without it the chat answers "offline" with the email.
ANTHROPIC_API_KEY=

# Model for the chat. Default: claude-haiku-4-5. Swap to e.g. claude-sonnet-5 without touching code.
CHAT_MODEL=claude-haiku-4-5

# Daily spend cap in input-token equivalents (output ×5, cache write ×1.25, cache read ×0.1). Default 1500000 ≈ $1.5/day on Haiku 4.5.
CHAT_DAILY_TOKEN_BUDGET=1500000

# Upstash Redis (free tier) for the per-IP rate limit and the daily budget. Without it limits are per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: lets `pnpm chat:evals` skip the per-IP rate limit (send the same value from the eval script).
CHAT_EVAL_SECRET=

NEXT_PUBLIC_SITE_URL=https://www.italik.dev
